#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "[Husky] Running pre-commit hooks..."

# 1. Run git-secrets (if installed)
if command -v git-secrets >/dev/null 2>&1; then
  echo "[Husky] Scanning for secrets..."
  git secrets --pre_commit_hook -- "$@"
else
  echo "[Husky] WARNING: git-secrets is not installed. Skipping secret scan."
fi

# 2. Run format check in the autopilot directory
echo "[Husky] Checking code formatting in autopilot..."
cd autopilot || exit 1

source ~/.nvm/nvm.sh
nvm use 20

# Run format check if the script exists, otherwise run next best thing or pass
if npm run | grep -q 'format:check'; then
    npm run format:check
else
    echo "[Husky] 'format:check' script not found in package.json. Skipping."
fi
