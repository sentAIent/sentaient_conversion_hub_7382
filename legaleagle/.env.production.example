# LEGAL EAGLE - PRODUCTION ENVIRONMENT VARIABLES
# Rename this file to .env.production and populate before running 'npm run build'

# 1. SUPABASE (PRODUCTION)
# Get these from your Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://[YOUR-PROD-PROJECT-ID].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-PROD-ANON-KEY]

# 2. STRIPE (LIVE MODE)
# Ensure this starts with 'pk_live_' not 'pk_test_'
VITE_STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxx

# 3. POSTHOG (ANALYTICS)
# Get from PostHog -> Project Settings
VITE_POSTHOG_KEY=phc_[YOUR_POSTHOG_LIVE_KEY]

# 4. EXTERNAL AI PROXIES / DOCKER
# If using a hosted API or local server with a static IP
VITE_DOCKER_API_URL=https://api.sentaient.com
VITE_DOCKER_API_KEY=[YOUR-SECURE-PROD-KEY]
