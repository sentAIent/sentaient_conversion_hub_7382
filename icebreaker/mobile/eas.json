{
  "cli": {
    "version": ">= 9.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4000/graphql"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://icebreaker-backend.onrender.com/graphql"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://icebreaker-backend.onrender.com/graphql"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
